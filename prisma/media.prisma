model Media {
  id          String  @id @default(cuid())
  name        String
  url         String
  fileKey     String  @unique
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  description String?

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
}

model MediaFolder {
  id   String @id @default(cuid())
  name String
  slug String @unique

  media Media[]

  createdAt DateTime @default(now())
}
